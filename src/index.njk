<!-- HERO -->
<!-- #207 — the anchor is the SECTION, not the field inside it. Every "Scan
     your site" on this site is a /#scan jump, and while the id sat on
     .scan-hero — the last child of a flex-centred min-height:100vh hero —
     the browser did exactly what it was told: it parked that div's top edge
     at y=0, which is precisely where the fixed 58px nav is. Measured at
     1440/1280/390: the form's top was 0 and its bottom 58, so the one
     control the anchor exists to reach was wholly behind the nav; the
     headline was ~300px above the fold; and a fifth to a quarter of what
     was left was the hero's own empty bottom padding — the grey the
     operator landed in with nothing to press.

     The hero is the first thing in the document, so targeting it resolves
     to scroll 0 and the headline and the field arrive together, which is
     the composition the page was drawn with. No scroll-margin-top here on
     purpose: the hero's 7rem top padding already clears the nav, and a rule
     that changes nothing is a rule the next person has to disprove. The
     other in-page targets (#what, #how, #pricing, #try) all carry 7rem of
     their own and were never affected. -->
<section class="hero" id="scan">
  <div class="hero-ai-tag">Prospektor Studio</div>

  <!-- The headline sits inside .hero-rest so a scan's focus mode still
       collapses it: from the moment a scan starts, the scan is the page. -->
  <div class="hero-rest" id="heroRest">
    <!-- #153: the two questions, in the order the product answers them. The
         accent lands on the second half deliberately — the WHO is the free
         half and the hook, the WHAT is what anyone is actually paying for. -->
    <h1>Who to pitch.<br><span class="accent">What to send.</span></h1>
    <p class="hero-sub">A full GTM team on every pitch: a BDR to research it, an SDR to find your way in, an AE to write what you send.</p>
  </div>

  <!-- The scan field: POST /api/scan, poll, render the proposal. scan.js drives it. -->
  <div class="scan-hero">
    <form class="scan-form" id="scanForm" novalidate>
      <span class="scan-form-label">$&nbsp;scan</span>
      <input class="scan-input" id="scanInput" type="text" inputmode="url" autocomplete="url"
             spellcheck="false" placeholder="yourcompany.com" aria-label="Your company website">
      <button class="scan-btn" type="submit" id="scanBtn">Scan</button>
    </form>
    <p class="scan-hint" id="scanHint">Free · no sign-up · it reads your site and proposes your targets in ~30 seconds</p>
    <p class="scan-error" id="scanError" hidden></p>

    <div aria-live="polite">
      <div class="scan-status" id="scanStatus" hidden>
        <div class="scan-progress"><div class="scan-progress-fill" id="scanBarFill"></div></div>
        <div class="scan-status-line"><span class="building-dot"></span><span id="scanStatusMsg"></span></div>
      </div>

      <div class="scan-result" id="scanResult" hidden>
        <div class="scan-result-meta" id="scanResultMeta"></div>
        <div class="scan-facts" id="scanFacts" hidden></div>
        <p class="scan-lead">Here's what Prospektor will find for you:</p>
        {#- Not a heading (#137). This is the scan's answer, written by scan.js after
         the fetch returns; as an <h3> it was an EMPTY heading sitting between the
         <h1> and the first <h2>, so every crawler read the homepage outline as
         h1 → h3(blank) → h2. A <p> says what it is — a line of result text that
         happens to be large — and the styling is unchanged because .scan-guess
         was always a class rule, never an element one. -#}
        <p class="scan-guess" id="scanGuess" role="status" aria-live="polite"></p>
        <ul class="scan-signals" id="scanSignals"></ul>
        <div class="scan-cta-row">
          <a class="btn-cta" id="scanCta" href="/checkout/">Start my studio →</a>
          <p class="scan-cta-note">Off target? Sharpen it in one sentence after checkout.</p>
        </div>
      </div>

      <div class="scan-fallback" id="scanFallback" hidden>
        <p class="scan-fallback-msg" id="scanFallbackMsg" hidden></p>
        <a class="btn-cta" id="scanFallbackCta" href="/checkout/">Start my studio →</a>
      </div>
    </div>
  </div>
</section>
{#- defer (#137). This sat mid-document without it, so the parser stopped
    here and rendered nothing below until the script had been fetched and
    run. Every one of these is an IIFE that looks its elements up by id and
    returns if they are absent, so deferring is not only cheaper — it is the
    case the guard was written for, with the DOM guaranteed complete. -#}
<script src="{{ '/assets/js/scan.js' | asset }}" defer></script>

